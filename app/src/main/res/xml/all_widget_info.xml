<?xml version="1.0" encoding="utf-8"?>
<!-- "All in one": starts four cells wide and two high; one row high it puts round buttons beside what comes next. -->
<!-- Preview layout and cell counts are for Android 12 and newer; older ones go by minWidth and minHeight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_all_description"
    android:initialLayout="@layout/widget_all"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:previewLayout="@layout/widget_all_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
