<?xml version="1.0" encoding="utf-8"?>
<!-- The only folders the app hands out: the downloaded update, for the phone's installer to read,
     and the photo, for the camera to write. Both are deleted right after use. -->
<paths>
    <cache-path
        name="update"
        path="update/" />
    <cache-path
        name="photo"
        path="photo/" />
</paths>
