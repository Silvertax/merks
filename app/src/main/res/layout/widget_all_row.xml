<?xml version="1.0" encoding="utf-8"?>
<!-- All in one, a single row: what comes next, then two round buttons to speak and to photograph; without room for what comes next, the buttons sit in the middle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_card"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingVertical="5dp"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    tools:ignore="UseAppTint">

    <include
        layout="@layout/widget_next_head"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <!-- The microphone, or the mascot when one was chosen for the widgets. -->
    <FrameLayout
        android:id="@+id/all_speak"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/w_circle_primary"
        android:contentDescription="@string/speak">

        <ImageView
            android:id="@+id/all_speak_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="13dp"
            android:src="@drawable/w_ic_mic"
            android:tint="@color/w_on_primary" />

        <ImageView
            android:id="@+id/all_speak_mascot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <ImageView
        android:id="@+id/all_photo"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/w_circle_tonal"
        android:contentDescription="@string/photo"
        android:padding="14dp"
        android:src="@drawable/w_ic_camera"
        android:tint="@color/w_on_tonal" />
</LinearLayout>
