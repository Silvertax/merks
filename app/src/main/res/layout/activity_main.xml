<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header: mark, name, sharing what is coming up (only when something is), settings. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface" />

        <!-- The mascot, if one was chosen; it cheers when tapped. -->
        <de.silvertax.merks.MascotView
            android:id="@+id/mascot"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/share"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share_upcoming"
            android:src="@drawable/ic_share"
            android:tooltipText="@string/share_upcoming"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- A newer version is out: said here, installed only on a tap. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/update_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="20dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/update_banner_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/update_later"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/update_later"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <Button
                    android:id="@+id/update_now"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:text="@string/update_get" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone" />

    <!-- Nothing yet: a friendly start. -->
    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp">

        <ImageView
            android:id="@+id/empty_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo" />

        <de.silvertax.merks.MascotView
            android:id="@+id/empty_mascot"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/empty_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/empty_text"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- The big buttons, always within reach of the thumb. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/speak"
            style="@style/Widget.Merks.Button.Big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/speak"
            app:icon="@drawable/ic_mic" />

        <!-- A letter or an appointment card: photographed instead of read out. -->
        <Button
            android:id="@+id/photo"
            style="@style/Widget.Merks.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="64dp"
            android:text="@string/photo_button"
            android:textSize="20sp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="26dp" />

        <!-- A picture someone sent, a PDF, a calendar file: read like a photo. -->
        <Button
            android:id="@+id/from_file"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="52dp"
            android:text="@string/from_file"
            app:icon="@drawable/ic_attach"
            app:iconGravity="textStart" />

        <Button
            android:id="@+id/add_widget"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:minHeight="52dp"
            android:text="@string/add_widget"
            app:icon="@drawable/ic_widgets"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
