<?xml version="1.0" encoding="utf-8"?>
<!-- "Up next": the next appointment or reminder; made taller it also lists the two after it. NextWidget fills it in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <include layout="@layout/widget_next_head" />

    <include layout="@layout/widget_next_more" />
</LinearLayout>
