<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen listening, for those who switched the small sheet off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="40dp"
        android:clipChildren="false">

        <View
            android:id="@+id/pulse"
            android:layout_width="134dp"
            android:layout_height="134dp"
            android:layout_gravity="center"
            android:alpha="0.22"
            android:background="@drawable/circle_bg"
            android:backgroundTint="?attr/colorPrimary" />

        <ImageView
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_bg"
            android:backgroundTint="?attr/colorPrimary"
            android:importantForAccessibility="no"
            android:padding="32dp"
            android:src="@drawable/ic_mic"
            app:tint="?attr/colorOnPrimary" />
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/spoken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/stop"
        style="@style/Widget.Merks.Button.Big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stop" />

    <Button
        android:id="@+id/retry"
        style="@style/Widget.Merks.Button.Big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/retry"
        android:visibility="gone" />

    <Button
        android:id="@+id/done"
        style="@style/Widget.Merks.Button.Big.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/done"
        android:visibility="gone" />

    <Button
        android:id="@+id/change"
        style="@style/Widget.Merks.Button.Big.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/edit_voice"
        android:visibility="gone" />

    <Button
        android:id="@+id/note"
        style="@style/Widget.Merks.Button.Big.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/note_add"
        android:visibility="gone" />

    <Button
        android:id="@+id/undo"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="56dp"
        android:text="@string/undo"
        android:visibility="gone" />
</LinearLayout>
