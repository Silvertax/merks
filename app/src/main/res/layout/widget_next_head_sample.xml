<?xml version="1.0" encoding="utf-8"?>
<!-- widget_next_head with a sample appointment, for the previews in the phone's widget list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/next_head"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="UseAppTint">

    <LinearLayout
        android:id="@+id/next_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/w_badge"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:minWidth="54dp"
        android:minHeight="58dp"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/next_badge_weekday"
            android:text="@string/widget_sample_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_badge_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/next_badge_day"
            android:text="@string/widget_sample_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="1dp"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_badge_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_badge_month"
            android:text="@string/widget_sample_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_badge_ink"
            android:textSize="12sp" />

        <!-- Nothing planned: a calendar instead of a date. -->
        <ImageView
            android:id="@+id/next_badge_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/w_ic_calendar"
            android:tint="@color/w_on_tonal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/next_texts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/next_up_label"
            android:textColor="@color/w_on_surface_variant"
            android:textSize="13sp" />

        <!-- Without the date tile, the day goes on top. -->
        <TextView
            android:id="@+id/next_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/w_accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:text="@string/widget_sample_title"
            android:textColor="@color/w_on_surface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/w_accent"
            android:text="@string/widget_sample_when"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
