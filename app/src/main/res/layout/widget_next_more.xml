<?xml version="1.0" encoding="utf-8"?>
<!--
    The two entries after the next one, below a thin line: day in front, lined up with the date tile
    above, time at the end. A narrow widget has no room for three columns: there the day stands above
    the title (next_stack2, next_stack3).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_more"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/next_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/w_outline" />

    <LinearLayout
        android:id="@+id/next_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/next_row2_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:minWidth="54dp"
            android:textColor="@color/w_accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/next_line2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/w_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/next_row2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/w_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/next_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/next_row3_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:minWidth="54dp"
            android:textColor="@color/w_accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/next_line3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/w_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/next_row3_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/w_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/next_stack2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/next_stack2_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/w_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/next_stack2_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/w_on_surface"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/next_stack3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/next_stack3_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/w_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/next_stack3_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/w_on_surface"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
